  "paths": {
    "/v1/html-to-markdown": {
      "post": {
        "tags": [
          "Live Web, Scraping & SEO Intelligence"
        ],
        "summary": "HTML to Clean Markdown",
        "description": "Transforms raw HTML markup into clean structured Markdown",
        "operationId": "execute_html_to_markdown",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "https://example.com"
            },
            "description": "Target webpage URL to process"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "api_id": "0002",
                  "latency_ms": 12,
                  "data": {
                    "endpoint": "html-to-markdown",
                    "title": "Example Domain",
                    "word_count": 42
                  },
                  "meta": {
                    "powered_by": "RebornEdge Global Edge Network (Cloudflare V8)",
                    "portal": "https://firstbabyreborn-ai.github.io/ext-remote-config/"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error or invalid input parameters",
            "content": {
              "application/json": {
                "example": {
                  "status": "error",
                  "code": "INVALID_INPUT",
                  "message": "Missing required parameter"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing RapidAPI or Bearer authorization headers",
            "content": {
              "application/json": {
                "example": {
                  "status": "error",
                  "code": "UNAUTHORIZED",
                  "message": "Provide RapidAPI subscription headers (X-RapidAPI-Key) or valid Bearer Workspace Token."
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "html": {
                    "type": "string",
                    "example": "<h1>Headline</h1><p>Content</p>"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
